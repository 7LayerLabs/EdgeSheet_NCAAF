CFBD_API_KEY=your-collegefootballdata-key
# Optional: identifies the app to the National Weather Service
NWS_USER_AGENT=ScoutTheSlate/0.1 (you@example.com)

# Telegram delivery (optional). See README "Telegram delivery".
# Token from @BotFather; chat id from: npm run telegram:chat-id (after messaging the bot once)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL used in message links (set to a Tailscale or public URL so links open from your phone)
PUBLIC_BASE_URL=http://localhost:3000
